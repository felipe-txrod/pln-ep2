# Optional Codex credential. Existing codex login authentication is also supported.
# Set the real value only in your shell or an ignored .env file.
# CODEX_API_KEY=replace-with-your-own-key
CASCADE_MODEL=gpt-6.1-sol
CASCADE_REASONING_EFFORT=low
CASCADE_BATCH_SIZE=8
CASCADE_WORKERS=2
CASCADE_RETRIES=1
CASCADE_TIMEOUT=180
CASCADE_CACHE=.cache/cascade/responses.sqlite3
# Standard API-equivalent USD per million tokens; subscription billing differs.
CASCADE_INPUT_PRICE_PER_MILLION=2
CASCADE_CACHED_INPUT_PRICE_PER_MILLION=0.10
CASCADE_OUTPUT_PRICE_PER_MILLION=10
