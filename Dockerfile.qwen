# The local validation reused pln-rocm:6.4.1. This recipe builds a separate stack.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv ca-certificates libnuma1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/qwen-venv
ENV PATH="/opt/qwen-venv/bin:${PATH}"
RUN python3 -m pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/rocm6.4 'torch==2.8.0+rocm6.4'
COPY requirements-qwen.txt /tmp/requirements-qwen.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements-qwen.txt 'pytest==8.4.2'
ENV PYTHONPATH=/workspace/src HF_HOME=/workspace/.cache/huggingface
ENV TOKENIZERS_PARALLELISM=false HF_HUB_DISABLE_TELEMETRY=1
WORKDIR /workspace
USER 1000:1000
ENTRYPOINT ["python3", "-m", "qwen_classifier"]
